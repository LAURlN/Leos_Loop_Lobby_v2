{
  "name": "leos-loop-lobby",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "app",
    "relay"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "dev:relay": "npm run dev -w relay",
